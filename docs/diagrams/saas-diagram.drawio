  <diagram name="Idea" id="mJztd4bKjqmgLuO7sb2t">
    <mxGraphModel dx="872" dy="471" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="Fq1FsSUK43pVBMhmzxOp-1" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;p data-end=&quot;351&quot; data-start=&quot;163&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;span style=&quot;font-size: 18px; text-wrap-mode: nowrap;&quot;&gt;&lt;b&gt;IDEA&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p data-end=&quot;351&quot; data-start=&quot;163&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Estamos haciendo &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;233&quot; data-start=&quot;180&quot;&gt;un backend de un SaaS de gestión de suscripciones&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;, es decir, el &lt;/span&gt;&lt;strong style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot; data-end=&quot;307&quot; data-start=&quot;248&quot;&gt;motor que maneja usuarios, planes, pagos y renovaciones&lt;/strong&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt; de un servicio que se cobra periódicamente.&lt;/span&gt;&lt;/p&gt;&lt;p data-end=&quot;351&quot; data-start=&quot;163&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p data-end=&quot;401&quot; data-start=&quot;353&quot;&gt;Piensa en que este backend podría ser usado por:&lt;/p&gt;&lt;ul data-end=&quot;597&quot; data-start=&quot;402&quot;&gt;&lt;li data-end=&quot;438&quot; data-start=&quot;402&quot;&gt;&lt;p data-end=&quot;438&quot; data-start=&quot;404&quot;&gt;Un servicio de streaming (Netflix)&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;490&quot; data-start=&quot;439&quot;&gt;&lt;p data-end=&quot;490&quot; data-start=&quot;441&quot;&gt;Una app de productividad (Notion, Trello Premium)&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;539&quot; data-start=&quot;491&quot;&gt;&lt;p data-end=&quot;539&quot; data-start=&quot;493&quot;&gt;Una herramienta de email marketing (Mailchimp)&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;597&quot; data-start=&quot;540&quot;&gt;&lt;p data-end=&quot;597&quot; data-start=&quot;542&quot;&gt;Un servicio de almacenamiento en la nube (Google Drive)&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
          <mxGeometry height="280" width="320" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="Fq1FsSUK43pVBMhmzxOp-3" parent="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="&lt;h2 style=&quot;text-wrap-mode: nowrap;&quot; data-end=&quot;1586&quot; data-start=&quot;1551&quot;&gt;¿Qué tendrá el sistema?&lt;/h2&gt;&lt;ul style=&quot;text-wrap-mode: nowrap;&quot; data-end=&quot;1929&quot; data-start=&quot;1587&quot;&gt;&lt;br&gt;&lt;li data-end=&quot;1640&quot; data-start=&quot;1587&quot;&gt;&lt;p data-end=&quot;1640&quot; data-start=&quot;1589&quot;&gt;&lt;strong data-end=&quot;1620&quot; data-start=&quot;1589&quot;&gt;Gestión de usuarios y roles&lt;/strong&gt;&amp;nbsp;(clientes y admins)&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;1690&quot; data-start=&quot;1641&quot;&gt;&lt;p data-end=&quot;1690&quot; data-start=&quot;1643&quot;&gt;&lt;strong data-end=&quot;1668&quot; data-start=&quot;1643&quot;&gt;Planes de suscripción&lt;/strong&gt;&amp;nbsp;con precio y duración&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;1738&quot; data-start=&quot;1691&quot;&gt;&lt;p data-end=&quot;1738&quot; data-start=&quot;1693&quot;&gt;&lt;strong data-end=&quot;1718&quot; data-start=&quot;1693&quot;&gt;Suscripciones activas&lt;/strong&gt;&amp;nbsp;con estado y fechas&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;1792&quot; data-start=&quot;1739&quot;&gt;&lt;p data-end=&quot;1792&quot; data-start=&quot;1741&quot;&gt;&lt;strong data-end=&quot;1750&quot; data-start=&quot;1741&quot;&gt;Pagos&lt;/strong&gt;&amp;nbsp;(simulados o integrados a Stripe Sandbox)&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;1869&quot; data-start=&quot;1793&quot;&gt;&lt;p data-end=&quot;1869&quot; data-start=&quot;1795&quot;&gt;&lt;strong data-end=&quot;1813&quot; data-start=&quot;1795&quot;&gt;Notificaciones&lt;/strong&gt;&amp;nbsp;por eventos importantes &lt;br&gt;(alta, renovación, cancelación)&lt;/p&gt;&lt;/li&gt;&lt;li data-end=&quot;1929&quot; data-start=&quot;1870&quot;&gt;&lt;p data-end=&quot;1929&quot; data-start=&quot;1872&quot;&gt;&lt;strong data-end=&quot;1897&quot; data-start=&quot;1872&quot;&gt;Renovación automática&lt;/strong&gt;&amp;nbsp;según configuración del usuario&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;" vertex="1">
